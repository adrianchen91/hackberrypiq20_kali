#!/bin/bash
# hackberry-touch: enable/disable the HackBerry touchscreen without touching the
# keyboard or trackpad.
#
#   hackberry-touch on|off   force the touchscreen on or off
#   hackberry-touch auto     off while any login session is locked, otherwise on
#   hackberry-touch status   print "on" or "off"
#   hackberry-touch watch    run forever, applying "auto" whenever logind reports
#                            a lock/unlock (event-driven, no polling; used by
#                            hackberry-touch.service)
#
# KDE sets logind's LockedHint when the screen locks and clears it on unlock.
# Only input devices bound to the edt_ft5x06 I2C driver (the EP0110M09 touch
# controller) are ever inhibited. The keyboard and trackpad are USB HID devices
# and can never match, so they cannot be disabled by this tool.
# Inhibiting uses the kernel's standard input "inhibited" attribute: the driver
# stays bound, so turning it back on is instant and needs no re-probe.

TOUCH_DRIVER="edt_ft5x06"

touch_devices() {
    local d drv
    for d in /sys/class/input/input*; do
        [[ -w "$d/inhibited" ]] || continue
        drv=$(readlink -f "$d/device/driver" 2>/dev/null) || continue
        [[ "${drv##*/}" == "$TOUCH_DRIVER" ]] && echo "$d"
    done
}

set_inhibit() {
    local value="$1" d found=1
    for d in $(touch_devices); do
        echo "$value" >"$d/inhibited" 2>/dev/null && found=0
    done
    return $found
}

# "locked" if any login session reports LockedHint=yes, else "unlocked".
# Fails safe: if logind cannot be queried, report unlocked so touch stays usable.
lock_state() {
    local id
    while read -r id _; do
        [[ -n "$id" ]] || continue
        [[ "$(loginctl show-session "$id" -p LockedHint --value 2>/dev/null)" == yes ]] && { echo locked; return; }
    done < <(loginctl list-sessions --no-legend 2>/dev/null)
    echo unlocked
}

case "${1:-}" in
    on)     set_inhibit 0 ;;
    off)    set_inhibit 1 ;;
    auto)   [[ "$(lock_state)" == locked ]] && set_inhibit 1 || set_inhibit 0 ;;
    status)
        d=$(touch_devices | head -n1)
        [[ -n "$d" ]] || { echo "no touchscreen found" >&2; exit 1; }
        [[ "$(<"$d/inhibited")" == 1 ]] && echo off || echo on
        ;;
    watch)
        "$0" auto
        # Re-evaluate on every logind lock/unlock event. LockedHint changes arrive as
        # PropertiesChanged on the session object; Lock/Unlock are logind's own signals.
        dbus-monitor --system \
            "type='signal',sender='org.freedesktop.login1',path_namespace='/org/freedesktop/login1/session'" \
            2>/dev/null |
        while read -r line; do
            case "$line" in
                *LockedHint*|*member=Lock*|*member=Unlock*) "$0" auto ;;
            esac
        done
        # dbus-monitor ended unexpectedly: exit non-zero so systemd restarts us
        exit 1
        ;;
    *)
        echo "usage: ${0##*/} on|off|auto|status|watch" >&2
        exit 2
        ;;
esac

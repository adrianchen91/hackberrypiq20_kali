# Lean profile: turns OFF loadable modules only. Merged after hackberry.config
# by build.sh --lean. build.sh verifies that no built-in (=y) option changes, so
# the kernel image stays identical and any module can be restored from a full
# build (see README: 'Restoring a module'). Generated from the module Makefiles
# against the full baseline config.
# allow-y-change: NFSD_ OCFS2_ GFS2_ CEPH_FS_ AFS_ DVB_USB_DIBUSB_ NF_CONNTRACK_OVS NF_NAT_OVS IP_VS_ SCTP_DEFAULT_COOKIE_HMAC_SHA256 L2TP_V3 BATMAN_ADV_ MTD_ MD_BITMAP ATM_DRIVERS IGB_ IXGBE_ IGC_ ATH9K_ B43 IWLWIFI_ SSB_ BCMA_ USB_PWC_ VIDEO_PVRUSB2_ VIDEO_AU0828_ VIDEO_CX231XX_ SND_SOC_COMPRESS JFS_ JFFS2_ UBIFS_ 9P_FS_ CLOSURES PLDMFW


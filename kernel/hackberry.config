# HackBerry deltas applied on top of arch/arm64/configs/bcm2712_defconfig.
# Keep this small: only what we deliberately differ on. build.sh checks that
# every line here survives olddefconfig and warns about any that do not.

# Identity. 16K pages are inherited from bcm2712_defconfig (ARM64_16K_PAGES=y).
CONFIG_LOCALVERSION="-hackberry-2712"

# Power / responsiveness
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=n
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Memory: compressed swap in RAM by default
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZO=n
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_CRYPTO_ZSTD=y

# Network: BBR + fq by default
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# Build size / time
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_MODULE_COMPRESS_ZSTD=y

# Hardening that does not break pentest tooling
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y

# Wireless: monitor mode and injection need these (nexmon patch lives in
# patches/0001-brcmfmac-nexmon.patch)
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REG_RELAX_NO_IR=y

# Pressure stall information on by default (systemd-oomd, memory-pressure tools)
CONFIG_PSI_DEFAULT_DISABLED=n

# Cheap hardening (typically 1-3% on allocation/copy-heavy loads)
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_KMALLOC_PARTITION_CACHES=y

# A wedged handheld should reset itself rather than sit hot in a bag.
# Pairs with the systemd runtime watchdog (setup script) for whole-system hangs.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_PANIC_TIMEOUT=10
